            { "k": "Pause", "z": "暂停游戏", "t": "bool", "d": "false", "h": "仅单人有效" },
            { "k": "AfterAction", "z": "点击后", "t": "enum", "o": ["CLOSE", "WAIT_FOR_RESPONSE", "NONE"], "d": "CLOSE" },
            { "k": "Columns", "z": "按钮列数", "t": "num", "d": "1" }
          ]
        },
        {
          "id": "body",
          "title": "正文",
          "fields": [
            { "k": "Body", "z": "正文元素", "t": "objlist", "f": [
              { "k": "Type", "z": "类型", "t": "enum", "o": ["text", "item"], "d": "text" },
              { "k": "Message", "z": "文字", "t": "text" },
              { "k": "Width", "z": "宽度（px）", "t": "num", "h": "文字最多 1024，物品最多 256" },
              { "k": "Item", "z": "物品", "t": "text", "h": "材质 / Mythic 物品 / mmoitems.TYPE.ID / 掉落表" },
              { "k": "Height", "z": "高度（px）", "t": "num", "d": "64" },
              { "k": "Decoration", "z": "显示数量与耐久条", "t": "bool" },
              { "k": "ShowTooltip", "z": "悬停显示提示", "t": "bool", "d": "true" }
            ] }
          ]
        },
        {
          "id": "inputs",
          "title": "输入项",
          "fields": [
            { "k": "Inputs", "z": "输入项", "t": "objlist", "h": "点击按钮时以 dialog.<Key> 传进技能", "f": [
              { "k": "Type", "z": "类型", "t": "enum", "o": ["text", "bool", "range", "option"], "d": "text" },
              { "k": "Key", "z": "键名", "t": "text", "h": "只能用字母、数字、下划线" },
              { "k": "Label", "z": "标签", "t": "text" },
              { "k": "Initial", "z": "初始值", "t": "text", "h": "支持占位符，不支持 MiniMessage" },
              { "k": "Width", "z": "宽度（px）", "t": "num", "d": "200" },
              { "k": "LabelVisible", "z": "显示标签", "t": "bool", "d": "true" },
              { "k": "MaxLength", "z": "最大字数", "t": "num", "d": "256" },
              { "k": "Multiline", "z": "多行", "t": "bool" },
              { "k": "MaxLines", "z": "最大行数", "t": "num" },
              { "k": "Height", "z": "高度（px）", "t": "num" }
            ] }
          ]
        },
        {
          "id": "buttons",
          "title": "按钮",
          "fields": [
            { "k": "Buttons", "z": "按钮", "t": "objlist", "f": [
              { "k": "Label", "z": "文字", "t": "text" },
              { "k": "Width", "z": "宽度（px）", "t": "num", "d": "150" },
              { "k": "Tooltip", "z": "悬停提示", "t": "text" },
              { "k": "Actions", "z": "点击动作", "t": "list", "h": "每行一个动作，如 run_command" }
            ] }
          ]
        }
      ]
    },

    "cinematic": {
