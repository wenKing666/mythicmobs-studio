              { "k": "Mapping", "z": "映射字符", "t": "text" },
              { "k": "Material", "z": "材质", "t": "text" },
              { "k": "Model", "z": "CustomModelData", "t": "num" },
              { "k": "Display", "z": "名字", "t": "text" },
              { "k": "Glint", "z": "附魔光效", "t": "bool" },
              { "k": "Hide", "z": "隐藏提示", "t": "list", "h": "每行一个 ItemFlag，如 ATTRIBUTES" },
              { "k": "Enchantments", "z": "附魔", "t": "list", "h": "每行「附魔 等级」" },
              { "k": "TooltipStyle", "z": "提示框样式", "t": "text" },
              { "k": "Skills", "z": "点击技能", "t": "skills" }
            ] }
          ]
        }
      ]
    },

    "dialog": {
      "kind": "dialog",
      "title": "对话窗口",
      "one": "对话",
      "dir": "dialogs",
      "keyPrefix": "MyDialog",
      "icon": "message-square",
      "wrap": true,
      "note": "Paper Dialog API，需要 Premium + Paper 1.21.6+。文本用 MiniMessage，写 &c 这种旧色码会导致打不开。",
      "groups": [
        {
          "id": "base",
          "title": "基础",
          "fields": [
            { "k": "Title", "z": "标题", "t": "text" },
