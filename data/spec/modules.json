{
  "_说明": "9 种配置类型的字段表。字段键：k=YAML 键名 z=中文 t=类型 d=默认值(只做提示不主动写) h=提示 o=枚举项 f=子字段 r=必填",
  "types": {
    "spawner": {
      "kind": "spawner",
      "title": "刷怪点",
      "one": "刷怪点",
      "dir": "Spawners",
      "keyPrefix": "my_spawner",
      "icon": "target",
      "wrap": true,
      "note": "文件被服务器加载后只能用游戏内指令改；在编辑器里改要先停服。",
      "groups": [
        {
          "id": "who",
          "title": "刷什么",
          "fields": [
            { "k": "MobName", "z": "怪物", "t": "text", "r": true, "h": "必须是 MythicMobs 内部名；也可写 25%MobA,75%MobB 做权重" },
            { "k": "MobLevel", "z": "怪物等级", "t": "num", "d": "1" },
            { "k": "MobsPerSpawn", "z": "每次刷几只", "t": "num", "d": "1" },
            { "k": "MaxMobs", "z": "最多存活", "t": "num", "d": "1", "h": "必须 ≥ 每次刷几只" },
            { "k": "UseWorldScaling", "z": "叠加世界等级", "t": "bool", "d": "false" }
          ]
        },
        {
          "id": "where",
          "title": "刷在哪",
          "fields": [
            { "k": "World", "z": "世界", "t": "text", "h": "世界文件夹名，留空 = 创建时的世界" },
            { "k": "SpawnerGroup", "z": "分组", "t": "text", "h": "用 /mm s g:<组> 批量改" },
            { "k": "X", "z": "X 坐标", "t": "num" },
            { "k": "Y", "z": "Y 坐标", "t": "num" },
            { "k": "Z", "z": "Z 坐标", "t": "num" },
            { "k": "Radius", "z": "水平半径", "t": "num", "d": "0" },
            { "k": "RadiusY", "z": "垂直半径", "t": "num", "d": "0" }
          ]
        },
        {
          "id": "timer",
          "title": "计时与冷却",
          "fields": [
            { "k": "UseTimer", "z": "按计时器刷", "t": "bool", "d": "true" },
            { "k": "Cooldown", "z": "冷却（秒）", "t": "num", "d": "0" },
            { "k": "Warmup", "z": "预热（秒）", "t": "num", "d": "0", "h": "激活后等这么久才开始冷却" },
            { "k": "Chance", "z": "生成概率", "t": "num", "d": "1", "h": "0.0–1.0；失败那一次不消耗冷却" }
          ]
        },
        {
          "id": "player",
          "title": "玩家与拴绳",
          "fields": [
            { "k": "CheckForPlayers", "z": "需要玩家在附近", "t": "bool", "d": "true" },
            { "k": "ActivationRange", "z": "激活半径", "t": "num", "d": "40" },
            { "k": "LeashRange", "z": "拴绳距离", "t": "num", "d": "-1", "h": "-1 = 不拴" },
            { "k": "HealOnLeash", "z": "拉回时回满血", "t": "bool", "d": "false" },
            { "k": "ResetThreatOnLeash", "z": "拉回时清仇恨", "t": "bool", "d": "false" }
          ]
        },
        {
          "id": "misc",
          "title": "其它",
          "fields": [
            { "k": "ShowFlames", "z": "显示火焰", "t": "bool", "d": "false" },
            { "k": "Breakable", "z": "可被破坏", "t": "bool", "d": "false" },
            { "k": "RandomRotation", "z": "随机朝向", "t": "bool", "d": "false" },
            { "k": "Conditions", "z": "激活条件", "t": "conds", "h": "不满足就不激活" },
            { "k": "SpawnConditions", "z": "出生点条件", "t": "conds", "h": "检查实际生成的位置" }
          ]
        }
      ]
    },

    "randomspawn": {
      "kind": "randomspawn",
      "title": "随机刷怪",
      "one": "随机刷怪规则",
      "dir": "RandomSpawns",
      "keyPrefix": "my_randomspawn",
      "icon": "shuffle",
      "wrap": true,
      "note": "决定原版自然刷怪时替换成什么，和刷怪点（Spawners）不是一回事。",
      "groups": [
        {
          "id": "who",
          "title": "刷什么",
          "fields": [
            { "k": "Action", "z": "方式", "t": "enum", "o": ["ADD", "REPLACE"], "d": "ADD", "h": "ADD = 额外加一只；REPLACE = 顶掉原版那只" },
            { "k": "Type", "z": "怪物名", "t": "text", "h": "多个用逗号分隔，也可写原版生物" },
            { "k": "Types", "z": "权重列表", "t": "list", "h": "每行「怪物名 权重」，和上面的单值二选一" },
            { "k": "Level", "z": "等级", "t": "num", "d": "1", "h": "只能写固定数字，不接受 3to7" }
          ]
        },
        {
          "id": "where",
          "title": "刷在哪",
          "fields": [
            { "k": "Worlds", "z": "世界", "t": "list", "h": "每行一个世界名" },
            { "k": "Biomes", "z": "群系", "t": "list", "h": "每行一个群系，如 JUNGLE" },
            { "k": "Structures", "z": "结构", "t": "list", "h": "如 minecraft:fortress；设了就只能在这些结构里刷" },
            { "k": "Reason", "z": "生成原因", "t": "list", "h": "如 NATURAL / SPAWNER，留空 = 不限" },
            { "k": "PositionType", "z": "位置类型", "t": "enum", "o": ["LAND", "SEA"], "d": "LAND", "h": "只在 Action: ADD 时生效" }
          ]
        },
        {
          "id": "weight",
          "title": "概率与优先级",
          "fields": [
            { "k": "Chance", "z": "生成概率", "t": "num", "d": "1" },
            { "k": "Priority", "z": "优先级", "t": "num", "d": "1", "h": "同一位置多条命中时，数字大的优先" },
            { "k": "Cooldown", "z": "冷却（秒）", "t": "num", "h": "同一条规则两次刷怪的最小间隔" },
            { "k": "UseWorldScaling", "z": "叠加世界等级", "t": "bool", "d": "true" }
          ]
        },
        {
          "id": "cond",
          "title": "条件",
          "fields": [
            { "k": "Conditions", "z": "条件", "t": "conds", "h": "任意一条不满足就不刷" }
          ]
        }
      ]
    },

    "stats": {
      "kind": "stats",
      "title": "自定义属性",
      "one": "属性",
      "dir": "stats",
      "keyPrefix": "MY_STAT",
      "icon": "activity",
      "wrap": true,
      "note": "stats.yml（可以放在 Packs 里）。物品上要用属性需要装 MythicCrucible。",
      "groups": [
        {
          "id": "base",
          "title": "基础",
          "fields": [
            { "k": "Enabled", "z": "启用", "t": "bool", "d": "true" },
            { "k": "AlwaysActive", "z": "强制作用于所有实体", "t": "bool", "d": "false" },
            { "k": "Type", "z": "类型", "t": "enum", "o": ["STATIC", "ADDITIVE", "ADDITIVE_MULTIPLIER", "COMPOUND_MULTIPLIER", "DAMAGE_MODIFIER", "DAMAGE_BONUS", "PROC"], "d": "STATIC", "h": "STATIC 用于纯计数属性；PROC 是按概率触发技能" },
            { "k": "Display", "z": "显示名", "t": "text" },
            { "k": "FormulaKey", "z": "公式键", "t": "text", "h": "占位符里用的短名，如 SPD" },
            { "k": "Priority", "z": "优先级", "t": "num" },
            { "k": "Rounding", "z": "保留小数位", "t": "num", "d": "2" }
          ]
        },
        {
          "id": "value",
          "title": "数值",
          "fields": [
            { "k": "BaseValue", "z": "基础值", "t": "num", "d": "0", "h": "没有父属性时用的静态基础值" },
            { "k": "Formula", "z": "基础值公式", "t": "text", "h": "有父属性时按公式算基础值，公式键用 FormulaKey 指定的短名" },
            { "k": "MinValue", "z": "最小值", "t": "num" },
            { "k": "MaxValue", "z": "最大值", "t": "num" }
          ]
        },
        {
          "id": "trigger",
          "title": "触发与依赖",
          "fields": [
            { "k": "Triggers", "z": "触发时机", "t": "list", "h": "写触发器去掉 on 前缀的短名，如 Attack / Damaged / Death" },
            { "k": "ExecutionPoint", "z": "计算时机", "t": "enum", "o": ["PRE", "POST"], "d": "PRE", "h": "PRE 在触发的事件之前算，POST 在之后算" },
            { "k": "ParentStats", "z": "依赖的父属性", "t": "list", "h": "本属性要靠哪些属性算出来，一行一个属性名" },
            { "k": "TriggerStats", "z": "触发者的属性", "t": "list", "h": "触发实体可能带的属性与公式键，空格分隔，如 FIRE_RESISTANCE FR" }
          ]
        },
        {
          "id": "fmt",
          "title": "显示格式",
          "fields": [
            { "k": "Formatting", "z": "格式", "t": "obj", "f": [
              { "k": "Additive", "z": "加法", "t": "text", "h": "如 +<value> Speed" },
              { "k": "Multiply", "z": "乘法", "t": "text", "h": "如 +<value>% Speed" },
              { "k": "Compound", "z": "复合", "t": "text", "h": "如 x<value>% Speed" },
              { "k": "Static", "z": "静态", "t": "text", "h": "如 Force <value> <display>" }
            ] },
            { "k": "ShowInLore", "z": "在 lore 里显示", "t": "obj", "f": [
              { "k": "Additive", "z": "加法", "t": "bool" },
              { "k": "Multiply", "z": "乘法", "t": "bool" },
              { "k": "Compound", "z": "复合", "t": "bool" }
            ] }
          ]
        },
        {
          "id": "hook",
          "title": "挂技能",
          "fields": [
            { "k": "Skills", "z": "技能", "t": "skills", "h": "属性触发时执行，如暴击粒子" },
            { "k": "Conditions", "z": "条件", "t": "conds" }
          ]
        }
      ]
    },

    "menu": {
      "kind": "menu",
      "title": "自定义菜单",
      "one": "菜单",
      "dir": "menus",
